# Versioned Vite bundles, CSS, self-hosted fonts and optimized images.
# Nitro and Vite add a fingerprint to /assets/ filenames, so they can be
# cached long-term without serving an outdated bundle after a new deployment.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Lovable images are vendored by immutable asset IDs and served locally.
/__l5e/assets-v1/*
  Cache-Control: public, max-age=31536000, immutable
